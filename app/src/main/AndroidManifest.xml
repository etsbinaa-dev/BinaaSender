<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- تنزيل صورة الفاتورة من خادم binaa-center-hub فقط -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- زر «⬅ بناء» العائم فوق واتساب للرجوع إلى «فرز وإرسال» بعد الإرسال -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+: لازم لمعرفة إن كان واتساب بزنس مثبتًا -->
    <queries>
        <package android:name="com.whatsapp.w4b" />
        <!-- لإيجاد تطبيق «بناء» المثبّت (WebAPK) والرجوع إلى نافذته مباشرة -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="binaa-center-hub.lovable.app" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Binaa Sender"
        android:icon="@android:drawable/ic_menu_send"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <!-- شاشة الحالة والتجربة -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            تُفتح من binaa-center-hub برابط:
            binaasender://send?u=<رابط الصورة المؤقت>&p=<الهاتف>&t=<النص>
            بلا واجهة: تنزّل الصورة، تفتح محادثة العميل في واتساب بزنس، ثم تُغلق.
        -->
        <activity
            android:name=".SendActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:theme="@style/Theme.Binaa.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="binaasender" android:host="send" />
            </intent-filter>
        </activity>

        <!--
            واتساب بزنس صار يتجاهل رقم المحادثة ويفتح «Envoyer à…»: هذه الخدمة تختار
            محادثة العميل هناك (بحث برقمه). لا ترسل شيئًا. تُفعَّل مرة من الإعدادات.
        -->
        <service
            android:name=".ChatPickerService"
            android:exported="false"
            android:label="Binaa Sender — اختيار المحادثة"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/chat_picker_service" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
